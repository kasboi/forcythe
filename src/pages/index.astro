---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../layouts/Footer.astro';
import Header from '../layouts/Header.astro';
import MarqueeSection from '../layouts/MarqueeSection.astro';

import Navbar from '../components/Navbar.astro';
import Spotlight from '../components/Spotlight.astro';
import CallToAction from '../components/CallToAction.astro';
import Innovation from '../components/Innovation.astro';
import Result from '../components/Result.astro';
import Blog from '../components/Blog.astro';

import Stories from '../components/Stories.jsx';
---

<BaseLayout
  title="Forcythe - Your Partner in Scalable Business Growth | Digital Solutions Expert"
>
  <Navbar />
  <main>
    <Header />
    <!-- Marquee Section -->
    <MarqueeSection />
    <!-- Success Stories -->
    <section class="py-12 px-32 lg:px-16 md:px-6">
      <h2
        class="text-5xl lg:text-4xl sm:text-3xl lg:leading-snug text-center max-w-screen-lg mx-auto my-8"
      >
        Discover the <span class="text-blue-500">transformative stories</span> of
        startups that scaled new heights with us
      </h2>
      <Stories client:load />
    </section>
    <!-- SPOTLIGHT -->
    <Spotlight />
    <!-- INNOVATION -->
    <Innovation />
    <!-- RESULT -->
    <Result />
    <!-- BLOG -->
    <Blog />
    <!-- CTA -->
    <CallToAction />
    <!-- FOOTER -->
    <Footer />
  </main>
</BaseLayout>

<style>
  main {
    background-image: url('../assets/header-background.svg');
    background-position: top;
    background-repeat: no-repeat;
    background-size: 85%;
  }

  @media (max-width: 768px) {
    main {
      background-size: 150%;
    }
  }

  @media (max-width: 640px) {
    main {
      background-size: 200%;
    }
  }
</style>
