---
import Button from './Button.astro';

import { Image } from 'astro:assets';
import image1 from '../assets/blog_1.webp';
import image2 from '../assets/blog_2.webp';
import image3 from '../assets/blog_3.webp';

const blogContent = [
  {
    image: image1,
    title: 'Will AI take over Art?',
  },
  {
    image: image2,
    title: 'Cryptocurrency vs Tokens',
  },
  {
    image: image3,
    title: 'Cryptocurrency and Crypto asset',
  },
];
---

<section class="px-28 py-20 xl:px-16 md:px-12 sm:px-6 md:py-8 sm:py-6">
  <div class="flex justify-between md:flex-col md:gap-4">
    <h2 class="text-4xl md:text-3xl">
      Read our articles, news and product blog
    </h2>
    <div>
      <Button>Visit Blog</Button>
    </div>
  </div>
  <div
    class="flex justify-between xl:gap-6 md:px-16 sm:px-4 md:flex-col md:gap-8 py-12"
  >
    {
      blogContent.map((blog) => (
        <div class="group rounded-2xl hover:border-b border-b-blue-500 rounded-b-2xl overflow-hidden">
          <Image
            src={blog.image}
            alt="Blog Image"
            class="w-full h-48 object-cover rounded-2xl mb-8 transition-all group-hover:scale-110"
          />
          <div class="border-l border-white pl-6 mb-3 transition-all group-hover:translate-x-4">
            <h3 class="text-xl mt-4">Blog</h3>
            <div class="flex gap-2 mb-6 items-center text-gray-400">
              <p>The Reformist</p>
              <div class="w-2 h-2 bg-white rounded-full" />
              <p>May 29th, 2024</p>
            </div>
            <h3 class="text-2xl mt-4">{blog.title}</h3>
          </div>
        </div>
      ))
    }
  </div>
</section>
