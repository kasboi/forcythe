---
const { children } = Astro.props;
---

<button class="text-black">
  <span><slot /></span>
  <div></div>
</button>

<style>
  button {
    display: inline-grid;
    grid-template-columns: 1fr;
  }

  span {
    background-color: #fff;
    padding: 10px 20px;
    border-radius: 100px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    grid-column: 1/-1;
    grid-row: 1/-1;
    position: relative;
    z-index: 10;
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  span:hover {
    background-color: #064386;
    color: #fff;
  }

  div {
    border: 2px dotted #fff;
    width: 100%;
    height: 100%;
    border-radius: 100px;
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    position: relative;
    left: -8px;
    top: 6px;
  }

  span:hover + div {
    border-color: #064386;
  }
</style>
