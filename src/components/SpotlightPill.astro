---
import Button from './Button.astro';
import { Image } from 'astro:assets';

import cameraMan from '../assets/camera-man.svg';
import planDesign from '../assets/plan-design.svg';
import planDevelop from '../assets/plan-develop.svg';
import planLaunch from '../assets/plan-launch.svg';

const plans = [
  {
    title: 'Your vision is unique.',
    description:
      "Nurture Your Idea into a Blueprint for Success with our strategic insights and industry expertise. Your vision is unique, let's us shape it.",
    image: cameraMan,
  },
  {
    title: 'Crafting the blueprint for success',
    description:
      'Design is more than aesthetics, it’s about creating user experiences that resonate and convert. Our design experts shape your vision into a stunning reality.',
    image: planDesign,
  },
  {
    title: 'Turning blueprints into reality.',
    description:
      'We breathe life into designs, building robust platforms ready to disrupt markets. Harness the experience of our development team to bring your Concept to Life.',
    image: planDevelop,
  },
  {
    title: 'Your launchpad to the market.',
    description:
      'Launching is just the beginning, we ensure your product makes a splash and keeps making waves, ensuring a continual customer acquisition.',
    image: planLaunch,
  },
];
---

<div class="flex justify-between items-center">
  <div class="basis-[50%] flex flex-col gap-6 items-start">
    <h2 class="text-4xl mb-12">
      From <span class="text-blue-400">Spark</span> to <span
        class="text-blue-400">Spotlight:</span
      > we take you every step of the way to success.
    </h2>
    <div
      class="py-4 px-4 rounded-full border-2 border-blue-300 self-stretch flex justify-between"
    >
      <button class="bg-blue-200/90 py-3 px-12 rounded-full">Idea</button>
      <button class="bg-blue-200/90 py-3 px-12 rounded-full">Design</button>
      <button class="bg-blue-200/90 py-3 px-12 rounded-full">Develop</button>
      <button class="bg-blue-200/90 py-3 px-12 rounded-full">Launch</button>
    </div>
    <div class="">
      <h3 class="text-3xl font-semibold mt-4 mb-12">Your vision is unique.</h3>
      <p class="text-lg text-gray-400 mb-4">
        Nurture Your Idea into a Blueprint for Success with our strategic
        insights and industry expertise. Your vision is unique, let's us shape
        it.
      </p>
    </div>
    <Button>Book a Call</Button>
  </div>
  <Image src={cameraMan} alt="camera-man img" />
</div>
