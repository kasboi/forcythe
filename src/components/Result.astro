<section
  class="px-26"
  style="background: linear-gradient(rgb(12, 38, 69) 20%, rgb(3, 5, 22) 60%);"
>
  <div class="result-bg max-w-screen-md mx-auto">
    <div
      class="pt-52 pb-20 max-w-xl mx-auto text-center px-5 md:pt-40 md:pb-14 sm:pt-20 sm:pb-10"
    >
      <div
        class="mb-20 max-w-md mx-auto md:mb-14 md:max-w-md sm:mb-14 sm:max-w-[19rem]"
      >
        <div class="">
          <p class="text-3xl font-medium md:text-2xl sm:text-xl">
            We build solutions that help <span class="text-blue-400"
              >businesses</span
            > of all sizes to <span class="text-blue-400">scale</span>
          </p>
        </div>
      </div>
      <div class="flex justify-evenly items-center gap-3 sm:justify-between">
        <div class="flex flex-col gap-1 text-left w-fit">
          <div
            class="number text-[3rem] text-blue-400 font-medium md:text-[2rem] sm:text-[1.7rem]"
            data-final="50"
          >
            0+
          </div>
          <span
            class="text-lg whitespace-nowrap max-w-full overflow-hidden text-ellipsis md:text-base sm:text-[15px]"
            >Clients</span
          >
        </div>
        <div class="flex flex-col gap-1 text-left w-fit">
          <div
            class="number text-[3rem] text-blue-400 font-medium md:text-[2rem] sm:text-[1.7rem]"
            data-final="120"
          >
            0+
          </div>
          <span
            class="text-lg whitespace-nowrap max-w-full overflow-hidden text-ellipsis md:text-base sm:text-[15px]"
            >Projects</span
          >
        </div>
        <div class="flex flex-col gap-1 text-left w-fit">
          <div
            class="number text-[3rem] text-blue-400 font-medium md:text-[2rem] sm:text-[1.7rem]"
            data-final="10"
          >
            0+
          </div>
          <span
            class="text-lg whitespace-nowrap max-w-full overflow-hidden text-ellipsis md:text-base sm:text-[15px]"
            >Team Leads</span
          >
        </div>
        <div class="flex flex-col gap-1 text-left w-fit">
          <div
            class="number text-[3rem] text-blue-400 font-medium md:text-[2rem] sm:text-[1.7rem]"
            data-final="10"
          >
            0+
          </div>
          <span
            class="text-lg whitespace-nowrap max-w-full overflow-hidden text-ellipsis md:text-base sm:text-[15px]"
            >Glorious Years</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .result-bg {
    background-image: url('../assets/forcythe-arc.svg');
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
  }

  @media (max-width: 768px) {
    .result-bg {
      background-image: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const duration = 1000;
    const numbers = document.querySelectorAll('.number');

    const animateNumbers = (number: Element) => {
      const finalValue = parseInt(number.getAttribute('data-final') ?? '0', 10);
      const increment = finalValue / (duration / 16); // Approximate 60fps

      let currentValue = 0;
      const interval = setInterval(() => {
        currentValue += increment;
        if (currentValue >= finalValue) {
          currentValue = finalValue;
          clearInterval(interval);
        }
        number.textContent = Math.floor(currentValue) + '+';
      }, 16); 
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateNumbers(entry.target);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    ); 

    numbers.forEach((number) => {
      observer.observe(number);
    });
  });
</script>
