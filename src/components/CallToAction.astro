---
import Button from '../components/Button.astro';
---

<section
  class="py-12 px-36 lg:px-20 md:px-12 sm:px-6 md:py-8 sm:py-6 cta-background"
>
  <div class="max-w-screen-lg mx-auto flex flex-col items-center">
    <h2
      class="text-blue-400 text-5xl md:text-3xl text-center max-w-screen-lg mx-auto my-3"
    >
      Ready to Scale?
    </h2>
    <h2 class="text-5xl md:text-3xl text-center max-w-screen-lg mx-auto mb-8">
      Join successful brands that chose us as their <span class="text-blue-400"
        >growth accelerator</span
      >
    </h2>
    <Button>Book a call</Button>
  </div>
</section>

<style>
  .cta-background {
    background: linear-gradient(0deg, rgb(7, 22, 38) 20%, rgb(3, 5, 22) 69%);
  }
</style>
