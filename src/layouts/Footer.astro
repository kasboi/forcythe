---
import { Image } from 'astro:assets';

import facebookIcon from '../assets/socials/facebook.svg';
import instagramIcon from '../assets/socials/instagram.svg';
import xIcon from '../assets/socials/x.svg';
import linkedinIcon from '../assets/socials/linkedin.svg';
import youtubeIcon from '../assets/socials/youtube.svg';
import podcastIcon from '../assets/socials/Icon.svg';
import forcytheLogo from '../assets/forcythe_logo.svg';

const footerText = [
  'About Us',
  'Services',
  'Portfolio',
  'Studio',
  'Foundations',
  'Careers',
  'Blog',
];
---

<div
  class="px-28 py-10 lg:px-12 md:px-6 sm:px-2 md:py-8 sm:py-6 bg-[#071626] secondary-background"
>
  <div
    class="grid grid-cols-3 gap-24 xl:gap-12 lg:grid-cols-2 my-10 md:grid-cols-1"
  >
    <div class="max-w-lg lg:col-span-2 lg:mb-0 md:col-span-1 sm:mb-10">
      <form class="w-full grid grid-cols-4">
        <input
          id="form-email"
          type="text"
          placeholder="Your Email Address"
          class="py-3 col-span-3 bg-transparent outline-none border border-white rounded-s-full px-4 text-sm placeholder:text-[#79767D]"
        />
        <button
          class="py-3 h-full bg-white text-black hover:bg-[#064386] hover:text-white custom-animate rounded-e-full text-sm font-medium border border-l-0 border-white"
        >
          Subscribe
        </button>
      </form>
      <div class="flex gap-3 mt-5 items-center">
        <div
          class="w-5 h-5 border-2 rounded-full bg-transparent border-white cursor-pointer flex items-center justify-center"
        >
        </div>
        <label for="form-email" class="text-sm text-white">
          I agree to receive other notifications from Forcythe
        </label>
      </div>
    </div>
    <div class="col-span-1 md:grid-cols-1 gap-10 md:gap-0">
      <div class="md:col-span-2 md:pr-10">
        <Image src={forcytheLogo} alt="forcythe logo" class="mb-5 md:mb-8" />
        <p class="text-base text-[#AEA9B1] leading font-normal">
          We are the growth company for businesses looking to scale. We are
          dedicated to transforming businesses with bespoke digital solutions
          that drive growth.
        </p>
        <div class="mt-10 flex md:hidden items-center gap-2">
          <a
            href="https://www.facebook.com/forcythe/"
            class="w-9 h-9 cursor-pointer rounded-full border-2 border-blue-400 flex justify-center items-center"
          >
            <Image src={facebookIcon} alt="social icons" />
          </a>
          <a
            href="https://www.instagram.com/forcythe"
            class="w-9 h-9 cursor-pointer rounded-full border-2 border-blue-400 flex justify-center items-center"
          >
            <Image src={instagramIcon} alt="social icons" />
          </a>
          <a
            href="https://twitter.com/forcythe_"
            class="w-9 h-9 cursor-pointer rounded-full border-2 border-blue-400 flex justify-center items-center"
          >
            <Image src={xIcon} alt="social icons" />
          </a>
          <a
            href="https://www.linkedin.com/company/forcythe/"
            class="w-9 h-9 cursor-pointer rounded-full border-2 border-blue-400 flex justify-center items-center"
          >
            <Image src={linkedinIcon} alt="social icons" />
          </a>
          <a
            href="https://www.youtube.com/@forcythe"
            class="w-9 h-9 cursor-pointer rounded-full border-2 border-blue-400 flex justify-center items-center"
          >
            <Image src={youtubeIcon} alt="social icons" />
          </a>
          <a
            href="https://podcasters.spotify.com/pod/show/the-future-insight"
            class="w-9 h-9 cursor-pointer rounded-full border-2 border-blue-400 flex justify-center items-center"
          >
            <Image src={podcastIcon} alt="social icons" />
          </a>
        </div>
      </div>
    </div>
    <div class="">
      <h3 class="mb-8 text-2xl font-bold">Company</h3>
      <ul class="flex flex-col gap-2">
        {
          footerText.map((text) => (
            <li class="text-base text-[#B3D0F2] font-medium">
              <a href="#">{text}</a>
            </li>
          ))
        }
      </ul>
      <div class="mt-10 hidden md:flex items-center gap-3 w-fit mx-auto">
        <div
          class="w-9 h-9 cursor-pointer rounded-full border-2 border-blue-400 flex justify-center items-center"
        >
          <Image src={facebookIcon} width={20} height={20} alt="social icons" />
        </div>
        <div
          class="w-9 h-9 cursor-pointer rounded-full border-2 border-blue-400 flex justify-center items-center"
        >
          <Image
            src={instagramIcon}
            width={20}
            height={20}
            alt="social icons"
          />
        </div>
        <div
          class="w-9 h-9 cursor-pointer rounded-full border-2 border-blue-400 flex justify-center items-center"
        >
          <Image src={xIcon} width={20} height={20} alt="social icons" />
        </div>
        <div
          class="w-9 h-9 cursor-pointer rounded-full border-2 border-blue-400 flex justify-center items-center"
        >
          <Image src={linkedinIcon} width={20} height={20} alt="social icons" />
        </div>
        <div
          class="w-9 h-9 cursor-pointer rounded-full border-2 border-blue-400 flex justify-center items-center"
        >
          <Image src={youtubeIcon} width={20} height={20} alt="social icons" />
        </div>
        <div
          class="w-9 h-9 cursor-pointer rounded-full border-2 border-blue-400 flex justify-center items-center"
        >
          <Image src={podcastIcon} width={20} height={20} alt="social icons" />
        </div>
      </div>
    </div>
  </div>
  <div class="copyright border-t-[1px] border-blue-400 mb-10">
    <p class="text-accent2 text-sm mt-5 text-center md:text-left">
      Copyright &copy; 2024 Forcythe. All rights reserved.
    </p>
  </div>
</div>

<style>
  .secondary-background {
    background-color: rgba(7, 22, 38, 1);
  }
</style>
